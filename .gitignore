artifacts/

# Local hook audit log (issue #39, item 7; never committed)
.agent-logs/

# #26: the SPA build output (Vite outDir ../Decisya.Bff/wwwroot) is never committed.
src/Decisya.Bff/wwwroot/

# Local-only operations notes (home network and NAS hand-over, #124). They hold private network
# addresses and account names, so they never reach the public repository or an image build context.
# N-016 (#259): the folder is .local.ops; the old name stays ignored in case a copy is left anywhere.
ops.local/
.local.ops/

# Norma's usage capture (#246, ADR-0023): token counts per issue, written by capture.py only. It must be
# ignored before the first capture (the capture refuses a folder git does not ignore).
/.local.usage/
.claude/journal.local.json
