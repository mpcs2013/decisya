# Caddyfile for the deployable stack (issue #120, ADR-0018, architecture note D2, G4-120-02;
# reworked by issue #178: no source-address allow-lists on published routes, the Keycloak admin
# paths on their own port, ADR-0016 R6 and R9.8 as amended on 2026-10-20).
#
# Stock Caddy with `tls internal` is the only TLS terminator and the only published listener, on two
# ports: 8443 (the app, the Keycloak realm, the back channel) and 8444 (the Keycloak admin console
# and the master realm, the id host only). Default deny on every site block: a request is proxied
# only when one of the named matchers below admits its path (and, for the back channel, its source
# address); anything else gets an empty 403.
#
# Who may reach a published port is decided by the NAS firewall (rules NAS-FW-8443 and NAS-FW-ADMIN
# in docs/runbooks/deployable-stack.md), not by this file: behind Container Manager's userland proxy
# Caddy sees the proxy's address, never the client's, so a source allow-list here would refuse every
# client. Container-to-container traffic keeps its real address, so the back-channel routes keep
# their `remote_ip` allow-lists, and every published route carries a `not remote_ip` over the two
# committed internal subnets, so that no container (Keycloak, the BFF, the Api) can use it.
#
# Each site block holds one `route`. A route is evaluated strictly in the order written (the
# `handle` directive is not: Caddy may reorder handle blocks by path length, which could let a
# broader matcher shadow a narrower one). The last line of every route is the catch-all 403.
#
# The three host names arrive as environment variables from the stack's .env (Compose `:?` makes
# an empty value a start error). They are substituted into this text BEFORE it is parsed, so a
# value with a space, a brace or a newline would add directives.
# `stackctl.py check` validates every value by type and runs `caddy adapt` over the real
# values, and deploy/tests runs the same adapt over documentation-range values (T120-04).
# Never add a variable here without a validator there. The ports are literals on purpose.
#
# The fixed Docker subnets below are committed on purpose (docker-compose.stack.yaml):
#   10.120.0.0/24  backchannel  Caddy 10.120.0.2, the BFF and the Api
#   10.120.1.0/24  idp          Caddy 10.120.1.2 and Keycloak
#
# Rules the guards check on the adapted JSON (deploy/tests/test_caddyfile.py):
#   - exactly two listeners, :8443 and :8444; tls internal and a body size limit on every block;
#   - every route that proxies is a back-channel route (a positive remote_ip inside the committed
#     subnets) or a published route listed in PUBLISHED_ROUTES (a `not remote_ip` over both
#     committed subnets and no positive remote_ip);
#   - the admin paths (/admin, /realms/master) are refused on 8443 and admitted only on 8444;
#   - on the id sites a path pattern holds no %, no // and no inner *, and no admitting route uses
#     path_regexp, expression, header or vars (so the guards' model of path matching stays true);
#   - no trusted_proxies: Caddy overwrites a client-supplied X-Forwarded-For, so the apps see the
#     real peer address from Caddy's fixed address only (T120-08);
#   - no log_credentials: the access log keeps redacting Authorization and Cookie (G3 ruling 2b);
#   - no upstream on port 9000 (Keycloak management) or 8081 (the apps' health listener).
#
# `admin off`: there is no admin API; Caddy is restarted, never reloaded. `skip_install_trust`:
# Caddy must never write its root into the container's OS store. No ACME and no egress.
{
	https_port 8443
	auto_https disable_redirects
	skip_install_trust
	admin off

	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

# Shared by every site block: internal CA, size limit, access log, and the matcher that catches
# any path still holding a dot-dot segment after decoding. The path matchers below match a
# cleaned path; refusing dot-dot first keeps an upstream's own normalisation from ever seeing a
# different path than the one that was admitted.
(edge) {
	tls internal
	header -Server
	request_body {
		max_size 1MB
	}
	log {
		output stdout
		format json
	}
	@dotdot path_regexp \.\.
}

# The SPA and the BFF (app host).
{$DECISYA_APP_HOST} {
	import edge

	# Keycloak's back-channel logout call, from the idp network only (POST, exact path).
	@idp_logout {
		remote_ip 10.120.1.0/24
		method POST
		path /bff/backchannel-logout
	}
	# S-120-01: nobody else may reach that path, whoever they are. Any other method, a sub-path
	# or a trailing slash is refused.
	@logout_other path /bff/backchannel-logout*
	# The published app route (NAS-FW-8443): every client the firewall lets in, never a container.
	@published_app {
		not remote_ip 10.120.0.0/24 10.120.1.0/24
	}

	route {
		respond @dotdot 403
		reverse_proxy @idp_logout bff:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
		respond @logout_other 403
		reverse_proxy @published_app bff:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
		respond 403
	}
}

# Keycloak (id host), port 8443. Port 9000 (management, health) is never routed.
{$DECISYA_ID_HOST} {
	import edge

	# The admin console and the master realm are never served here (#178): they have their own port.
	# Keycloak would also answer the admin API on this host name, so this refusal is explicit and
	# comes before every admitting route.
	@admin_paths path /admin /admin/* /realms/master /realms/master/*
	# S-178-02: a path that still holds an encoded dot, slash or backslash after Caddy's single
	# decode was double-encoded. Keycloak's paths never need one.
	@encoded path_regexp "(?i)%(2e|2f|5c)"
	# The published realm route (NAS-FW-8443): the decisya realm (login, token, discovery) and
	# Keycloak's static resources, for every client the firewall lets in, never a container.
	@published_realm {
		not remote_ip 10.120.0.0/24 10.120.1.0/24
		path /realms/decisya /realms/decisya/* /resources/*
	}
	# The BFF and the Api (discovery, token, JWKS) over the back channel: the decisya realm only.
	@backchannel_realm {
		remote_ip 10.120.0.0/24
		path /realms/decisya /realms/decisya/*
	}

	route {
		respond @dotdot 403
		respond @admin_paths 403
		respond @encoded 403
		reverse_proxy @published_realm keycloak:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
		reverse_proxy @backchannel_realm keycloak:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
		respond 403
	}
}

# Keycloak's admin console and the master realm (#178, ADR-0016 R9.8 amended): their own published
# port, the id host only. The NAS firewall admits 8444 from the workstation only (NAS-FW-ADMIN).
# /resources/* carries the console's and the login theme's static files. Container sources never
# use this route.
{$DECISYA_ID_HOST}:8444 {
	import edge

	@encoded path_regexp "(?i)%(2e|2f|5c)"
	@admin_console {
		not remote_ip 10.120.0.0/24 10.120.1.0/24
		path /admin /admin/* /realms/master /realms/master/* /resources/*
	}

	route {
		respond @dotdot 403
		respond @encoded 403
		reverse_proxy @admin_console keycloak:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
		respond 403
	}
}

# The Api (api host): reachable from the back-channel network only, /api/* only. The BFF calls it
# here over TLS (the #19 https invariant); Keycloak is not on that network.
{$DECISYA_API_HOST} {
	import edge

	@backchannel_api {
		remote_ip 10.120.0.0/24
		path /api/*
	}

	route {
		respond @dotdot 403
		reverse_proxy @backchannel_api api:8080 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
		respond 403
	}
}
