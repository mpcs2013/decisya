# Environment template for the deployable stack (issue #120, ADR-0018 D1, G3 G4-120-02).
#
# Keys and comments only. EVERY VALUE IS EMPTY, and a test fails if one is ever filled in here.
# This file is committed. The real values are local configuration and never enter the repository:
# `stackctl.py assemble` copies this file to the stack folder as its environment file (mode 0600,
# never overwritten) and you fill the copy in on the host. The stack folder lives outside any Git
# working tree. `stackctl.py check` refuses an empty or malformed value, a key that is not listed
# here (so no COMPOSE_FILE, COMPOSE_PROFILES or similar). An older file that still has
# DECISYA_LAN_SUBNET or DECISYA_WORKSTATION_ADDRESS fails the check: remove both keys (#178).
#
# No quotes, no spaces, no comments after a value. Examples below use the RFC 5737 documentation
# ranges; they are never real addresses.

# The one address Caddy publishes on: a single IPv4 unicast address of this host. Never 0.0.0.0.
# Example: 192.0.2.10
DECISYA_BIND_ADDRESS=

# The HTTPS port. Must be 8443: the back channel reaches Caddy on 8443 through the host aliases.
DECISYA_HTTPS_PORT=

# The admin port: Keycloak's admin console and the master realm, on the id host only. Must be 8444:
# Caddy's admin listener and Keycloak's admin URL (KC_HOSTNAME_ADMIN) use it. Who may reach it is
# decided by the NAS firewall rule NAS-FW-ADMIN (docs/runbooks/deployable-stack.md), not by this file.
DECISYA_ADMIN_PORT=

# Host names, lowercase letters, digits and hyphens, at least two labels, all three different.
# Example: app.p0.home.arpa
DECISYA_APP_HOST=
DECISYA_ID_HOST=
DECISYA_API_HOST=

# Release images, by digest, copied from the images.txt of the release whose tag equals version.txt
# and only after the cosign verify commands of that release's VERIFY.txt have passed. The form is
# ghcr.io/mpcs2013/decisya-<api|bff|migrator>@sha256:<64 hex>, and `stackctl.py check` also requires
# each value to equal the line in the stack folder's images.txt.
DECISYA_API_IMAGE=
DECISYA_BFF_IMAGE=
DECISYA_MIGRATOR_IMAGE=
