{
  "realm": "decisya",
  "displayName": "Decisya",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(3)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "tenant-user",
        "description": "An ordinary Decisya user, scoped to their own tenant."
      },
      {
        "name": "platform-admin",
        "description": "Cross-tenant platform operator; backs [AllowCrossTenant]-attributed, audited admin handlers (ADR-0001). No tenant_id."
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "decisya-bff",
      "roles": [
        "tenant-user",
        "platform-admin"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "decisya-bff",
      "name": "Decisya BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.DECISYA_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://localhost:7200/signin-oidc"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "acr",
        "web-origins"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "access.token.signed.response.alg": "RS256",
        "id.token.signed.response.alg": "RS256",
        "post.logout.redirect.uris": "https://localhost:7200/signout-callback-oidc",
        "backchannel.logout.session.required": "true",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "request.object.signature.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "aggregate.attrs": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-decisya-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "decisya-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-cli",
      "protocol": "openid-connect",
      "publicClient": true,
      "enabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant\",\"validations\":{\"pattern\":{\"pattern\":\"^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",\"error-message\":\"error-invalid-tenant-id\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "dev-alice",
      "email": "alice@decisya.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Alice",
      "requiredActions": [],
      "realmRoles": [
        "tenant-user"
      ],
      "attributes": {
        "tenant_id": [
          "7c9e6679-7425-40de-944b-e07fc1f90ae7"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${env.DECISYA_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-bob",
      "email": "bob@decisya.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Bob",
      "requiredActions": [],
      "realmRoles": [
        "tenant-user"
      ],
      "attributes": {
        "tenant_id": [
          "2f1a8d5e-3b4c-4e6f-9a7b-1c2d3e4f5a6b"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${env.DECISYA_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dev-admin",
      "email": "admin@decisya.test",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "requiredActions": [],
      "realmRoles": [
        "platform-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${env.DECISYA_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
