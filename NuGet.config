<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for every restore (ADR-0019 decision 5 and amendment A6, issue #164).
  <clear/> drops machine and user sources, so these two are the only ones. Source mapping sends Ostium.*
  to the private feed only and every other id to nuget.org only (an Ostium.* id squatted on nuget.org is
  never fetched). No credential ever lives here: the workstation keeps it at user level and CI passes the
  job token on restore steps only (NuGetPackageSourceCredentials_ostium). Directory.Build.targets
  (DECISYA0008) refuses any other restore source.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="ostium" value="https://nuget.pkg.github.com/mpcs2013/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ostium">
      <package pattern="Ostium.*" />
    </packageSource>
  </packageSourceMapping>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
