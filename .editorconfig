root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,md,ts,tsx,js,css}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:error
dotnet_diagnostic.CA2100.severity = error   # SQL injection review
dotnet_diagnostic.CA5350.severity = error   # weak crypto
dotnet_diagnostic.CA5351.severity = error
dotnet_diagnostic.CA5359.severity = error   # cert validation disabled
dotnet_diagnostic.CA5391.severity = error   # antiforgery on controllers
dotnet_diagnostic.RS0030.severity = error   # banned API (BannedSymbols.txt)
dotnet_diagnostic.IDE0005.severity = warning
