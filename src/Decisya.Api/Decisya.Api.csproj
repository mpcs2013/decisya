<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Telemetry, health and the JSON log pipeline all arrive through AddServiceDefaults;
         #20 adds JWT validation and the first business endpoints to this same project. -->
    <ProjectReference Include="..\Decisya.ServiceDefaults\Decisya.ServiceDefaults.csproj" />
    <!-- #21: the Tenancy module's endpoints, JIT provisioning gate and TenancyDbContext.
         Brings Npgsql.EntityFrameworkCore.PostgreSQL (and so EF Core) in transitively, which
         is what src/Decisya.Api/Errors/ConcurrencyConflictExceptionHandler.cs needs; identity-dev
         wires AddTenancyModule/MapTenancyEndpoints into Program.cs separately (G2, G4 order 3). -->
    <ProjectReference Include="..\Modules\Tenancy\Decisya.Modules.Tenancy\Decisya.Modules.Tenancy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #20: JWT bearer validation of Keycloak access tokens (already pinned in
         Directory.Packages.props; ADR-0002, ADR-0003). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Program.cs uses top-level statements, so the generated Program class is internal.
      WebApplicationFactory<Program> needs to see it. The alternative, a
      `public partial class Program;` declaration in the global namespace, trips CA1050
      and would add a public type to the host's API surface for a test's benefit.
    -->
    <InternalsVisibleTo Include="Decisya.Api.Tests" />
  </ItemGroup>

</Project>
