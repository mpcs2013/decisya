<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared platform infrastructure (issue #22), not a module: TenantDbContext, the tenant
    isolation exception and the TenantId <-> uuid value converter every Decisya.Modules.*
    DbContext builds on (module-scaffold's "tenancy" phase). Referenced from a module's own
    Infrastructure/ folder, the same way ServiceDefaults is referenced from a host project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Npgsql.EntityFrameworkCore.PostgreSQL (already pinned): first use in src/. Brings
      EF Core 10 (named query filters) transitively; Postgres is the only provider (ADR-0007).
    -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Decisya.SharedKernel\Decisya.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TenancyRuleTests builds contexts through the public constructor convention and
         reads TenantIsolationException.EntityTypeNames; TenantIdValueConverter stays
         internal but Decisya.ArchitectureTests never needs to see it directly. -->
    <InternalsVisibleTo Include="Decisya.Infrastructure.Persistence.Tests" />
  </ItemGroup>

</Project>
