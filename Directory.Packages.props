<Project>
  <!--
    Central Package Management. Target: .NET 10 LTS (ADR-0009) + Aspire 13.5.
    Aspire is pinned to 13.5.4 — never mix Aspire versions (runtime TypeLoadException).
    Aspire.Hosting.AppHost is not listed: Aspire.AppHost.Sdk/13.5.4 in Decisya.AppHost.csproj
    adds it implicitly (NU1009 if it is also listed here). Bump the SDK line and these together.
    Aspire.Hosting.Keycloak ships only as a preview; move to the first stable 13.5.x when published.
    OpenTelemetry instrumentation packages version independently of the core packages.
    Do not guess versions here. Add or bump via:  dotnet add <project> package <Id>
    VS 2026: Manage NuGet Packages for Solution → the version lands here automatically.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- No per-project version bypass (#59, G4-59-13). Directory.Build.targets enforces these
         three after each project body, so a .csproj cannot switch them back (G4-59-14). -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Dependency injection abstractions: SharedKernel exposes an IServiceCollection
         extension to register NodaTime's IClock; this is the same DI surface every
         ASP.NET Core / Aspire service in the solution already uses. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- Hosting / Aspire -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.5.4" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.5.4-preview.1.26464.4" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.5.4" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.5.4" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <!-- Web -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- Messaging / data -->
    <PackageVersion Include="WolverineFx" Version="6.39.1" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.39.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NodaTime" Version="3.3.4" />
    <PackageVersion Include="Npgsql.NodaTime" Version="10.0.3" />
    <!-- Test-only: NodaTime.Testing's FakeClock is the standard companion package for
         deterministically pinning/advancing IClock in unit tests (0.04 Story 4). -->
    <PackageVersion Include="NodaTime.Testing" Version="3.3.4" />
    <!-- AI -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- AwesomeAssertions (Apache-2.0 fork) instead of FluentAssertions: FA 8+ requires a paid commercial license. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- Test-only: starts the real Aspire AppHost in a test (DistributedApplicationTestingBuilder)
         to prove the resource wiring, the OTLP environment injection and the stdout
         correlation. Referenced only by tests/Decisya.AppHost.Tests, and pinned to the
         same 13.5.4 as Aspire.AppHost.Sdk — never mix Aspire versions. -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.4" />
    <!-- Test-only: Microsoft Testing Platform's native code-coverage collector, used to
         verify NFR-07 (>= 95% line coverage on SharedKernel's Money/Currency/Clock
         types); coverlet.collector targets the retired VSTest pipeline, not the
         MTP-mode `dotnet test` this repo's xunit.v3 projects use (see global.json). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>
</Project>
