<Project>
  <!--
    Central Package Management. Target: .NET 10 LTS (ADR-0009) + Aspire 13.6.
    Aspire is pinned to 13.6.5 (#318, GHSA-f7vh-h5g3-7jrh) — never mix Aspire versions (runtime TypeLoadException).
    Aspire.Hosting.AppHost is not listed: Aspire.AppHost.Sdk/13.6.5 in Decisya.AppHost.csproj
    adds it implicitly (NU1009 if it is also listed here). Bump the SDK line and these together:
    Dependabot's aspire group never moves the SDK line, so finish its PRs by hand.
    Aspire.Hosting.Keycloak ships only as a preview; move to the first stable 13.6.x when published.
    OpenTelemetry instrumentation packages version independently of the core packages.
    Do not guess versions here. Add or bump via:  dotnet add <project> package <Id>
    VS 2026: Manage NuGet Packages for Solution → the version lands here automatically.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- No per-project version bypass (#59, G4-59-13). Directory.Build.targets enforces these
         three after each project body, so a .csproj cannot switch them back (G4-59-14). -->
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Dependency injection abstractions: SharedKernel exposes an IServiceCollection
         extension to register NodaTime's IClock; this is the same DI surface every
         ASP.NET Core / Aspire service in the solution already uses.
         10.0.15 since #320 (.NET 10.0.15 servicing; Aspire 13.6.5 needs >= 10.0.14, NU1109 below). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <!-- Hosting / Aspire -->
    <!-- #120 (ADR-0018 D1): Compose publishing from the AppHost's publish-mode model; same 13.6.5 as the SDK. -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Keycloak" Version="13.6.5-preview.1.26559.7" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.6.5" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.10.0" />
    <!-- Web -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <!-- #341 (Marco 2026-11-21, G2 Q1 option A): build-time OpenAPI document generation for the
         Ledger contract test, in Decisya.Api only; no document route is mapped (G3 M341-06). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- Messaging / data -->
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.64.0" />
    <!-- #231: test projects only; the Api loads handler code statically (ADR-0024 amendment). -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NodaTime" Version="3.3.7" />
    <PackageVersion Include="Npgsql.NodaTime" Version="10.0.3" />
    <!-- Test-only: NodaTime.Testing's FakeClock is the standard companion package for
         deterministically pinning/advancing IClock in unit tests (0.04 Story 4). -->
    <PackageVersion Include="NodaTime.Testing" Version="3.3.7" />
    <!-- AI -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <!-- Observability -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- AwesomeAssertions (Apache-2.0 fork) instead of FluentAssertions: FA 8+ requires a paid commercial license. -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.16.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Test-only: starts the real Aspire AppHost in a test (DistributedApplicationTestingBuilder)
         to prove the resource wiring, the OTLP environment injection and the stdout
         correlation. Referenced only by tests/Decisya.AppHost.Tests, and pinned to the
         same 13.6.5 as Aspire.AppHost.Sdk — never mix Aspire versions. -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.5" />
    <!-- Test-only: Microsoft Testing Platform's native code-coverage collector, used to
         verify NFR-07 (>= 95% line coverage on SharedKernel's Money/Currency/Clock
         types); coverlet.collector targets the retired VSTest pipeline, not the
         MTP-mode `dotnet test` this repo's xunit.v3 projects use (see global.json). -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!-- Ostium identity packages (ADR-0019, issue #164): exact pins on the private feed (NuGet.config maps
         Ostium.* there only). Every change needs Marco's A3 check (signed checksums, RESULT: PASS) and
         regenerated lock files; the lock files and locked restore make the pin exact. -->
    <PackageVersion Include="Ostium.Authentication.Jwt" Version="0.5.1" />
    <PackageVersion Include="Ostium.Authentication.Jwt.Testing" Version="0.5.1" />
    <PackageVersion Include="Ostium.Backchannel" Version="0.5.1" />
    <!-- #166's transitive MessagePack pin (GHSA-qhrr-8q5h-9q3h) is gone since #318: Aspire.Hosting 13.6.5
         depends on MessagePack 2.5.307 directly, above StreamJsonRpc 2.25.29's 2.5.302. -->
  </ItemGroup>
</Project>
