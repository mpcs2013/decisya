<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <AnalysisModeSecurity>All</AnalysisModeSecurity>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- NuGet audit, explicit rather than the SDK default (#59, G4-59-16). With
             TreatWarningsAsErrors, NU1901-NU1904 fail the restore, the one package gate that
             runs before any package build code. Directory.Build.targets keeps both on. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <!-- Required for IDE0005 (unused usings) to run on build; CS1591 (missing XML comment) is not enforced. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <InvariantGlobalization>false</InvariantGlobalization>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- Bans DateTime.Now, DateTime.UtcNow, DateTimeOffset.Now and double-typed money helpers repo-wide. -->
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
    </ItemGroup>

    <!--
      Release images (#119, ADR-0017, docs/architecture/release-supply-chain.md D1). Container settings are central,
      so no csproj changes and no per-project drift. Conditioned on the project name, which is available here
      (see the Decisya.RepoRoot note below). RuntimeIdentifier is NOT set: release_images.py passes -r linux-x64 on
      the command line, so the normal build, the tests and the AppHost are unaffected. ContainerBaseImage is not set
      here either: release_images.py passes the digest-pinned value from .github/release/base-images.Dockerfile and
      Directory.Build.targets (DECISYA0006) refuses anything else. The SPA is served by the BFF, so there is no Web
      image. No ReadyToRun, no Native AOT, no instruction-set options: the NAS CPU is x86-64-v2 (ADR-0016 F6).
    -->
    <PropertyGroup Label="Release images (#119)"
                   Condition="'$(MSBuildProjectName)' == 'Decisya.Api' Or '$(MSBuildProjectName)' == 'Decisya.Bff' Or '$(MSBuildProjectName)' == 'Decisya.Infrastructure.Migrator'">
        <IsDecisyaReleaseImage>true</IsDecisyaReleaseImage>
        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
        <ContainerUser>1654</ContainerUser>
        <SelfContained>false</SelfContained>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishAot>false</PublishAot>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Decisya.Api'">
        <ContainerRepository>decisya-api</ContainerRepository>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Decisya.Bff'">
        <ContainerRepository>decisya-bff</ContainerRepository>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Decisya.Infrastructure.Migrator'">
        <ContainerRepository>decisya-migrator</ContainerRepository>
    </PropertyGroup>

    <!--
      Build output location (ADR-0010, issue #36). Host bin/obj move out of the working
      tree, so an agent sandbox session and a host session never write build output into
      files the other one's tools then execute or import (threat model T-04, G4-05).
      Sandbox: inside the container's home volume, never on the repository bind mount.
      Windows host: outside the working tree, keyed per clone so two clones never collide.
      Otherwise (CI on Linux, other OSes): the SDK default $(MSBuildThisFileDirectory)artifacts,
      which is git-ignored.
    -->
    <PropertyGroup Label="Build output location (ADR-0010, issue #36)">
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ArtifactsPath Condition="'$(DECISYA_SANDBOX)' == 'true'">/home/vscode/.decisya-build/artifacts</ArtifactsPath>
        <ArtifactsPath Condition="'$(DECISYA_SANDBOX)' != 'true' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\decisya\artifacts\$([MSBuild]::StableStringHash('$(MSBuildThisFileDirectory)'))</ArtifactsPath>
    </PropertyGroup>

    <!--
      Decisya.RepoRoot (ADR-0010, issue #36, G4-05): tests/Decisya.SharedKernel.Tests/RepoPaths.cs
      finds the repo root by walking up from AppContext.BaseDirectory to decisya.slnx. With
      UseArtifactsOutput moving bin/ out from under the project (and, for the sandbox and the
      Windows host above, out of the working tree entirely), that walk no longer reaches the
      repo. This assembly-level metadata gives RepoPaths a direct answer to fall back to.

      CORRECTED (N-02, docs/security/reviews/36.md G6 review): stamped only on test projects,
      via a Condition MSBuild can evaluate at Directory.Build.props time: MSBuildProjectName
      is a built-in property, available before the project body or any SDK target runs, unlike
      '$(IsTestProject)' (not set until Microsoft.NET.Test.Sdk's own .targets run, later than
      this file is evaluated; the original, unconditional version of this block existed only
      because '$(IsTestProject)' does not work here, not because every assembly needed it). A
      shipped src/ assembly no longer embeds the machine- or CI-runner-specific repo path.
      Not affected by the ContinuousIntegrationBuild "/_/" source path map, which only rewrites
      compile-time source paths, not AssemblyMetadata item values.
    -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <AssemblyMetadata Include="Decisya.RepoRoot" Value="$(MSBuildThisFileDirectory)" />
    </ItemGroup>
</Project>
