{
  "$comment": "Write/Edit allow-lists per project agent, enforced by .claude/hooks/agent_boundaries.py. Paths are repo-relative globs; '**' matches any depth. 'deny' applies to every project agent. The main session and built-in agents are not restricted.",
  "deny": ["docs/ai/pipeline/**", ".claude/**", "CLAUDE.md"],
  "agents": {
    "product-owner": ["docs/requirements/**"],
    "architect": ["docs/**", "src/Modules/*/Decisya.Modules.*.Contracts/**"],
    "security-reviewer": ["docs/security/**"],
    "backend-dev": ["src/**", "tests/**", "deploy/**", "Directory.Packages.props"],
    "frontend-dev": ["src/Decisya.Web/**", "tests/e2e/**"],
    "test-engineer": ["tests/**", "docs/requirements/**"],
    "devops": [".github/**", "deploy/**", "docs/runbooks/**", "src/Decisya.AppHost/**", "Directory.Build.props", "Directory.Packages.props", "global.json", "dotnet-tools.json", ".pre-commit-config.yaml", ".gitattributes", ".editorconfig"],
    "compliance-auditor": ["docs/compliance/**", "docs/security/samm.md"],
    "tech-writer": ["docs/**", "CHANGELOG.md", "README.md"]
  }
}
