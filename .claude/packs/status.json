{
  "schema": 1,
  "name": "status",
  "keys": {
    "factory": {
      "kind": "string",
      "required": true,
      "pattern": "[a-z0-9]|(?!.*--)[a-z0-9][a-z0-9-]{0,38}[a-z0-9]",
      "min": 1,
      "max": 40
    },
    "phases": {
      "kind": "string_list",
      "required": true,
      "item_pattern": "(?:[0-9]{1,3}|[0-9]{1,3}\\.[0-9]{1,3})=(?:[A-Za-z0-9]|[A-Za-z0-9][ -~]{0,58}[!-~])",
      "min_items": 1,
      "max_items": 50,
      "unique": true,
      "max_length": 70
    }
  }
}
