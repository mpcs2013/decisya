{
  "permissions": {
    "allow": [
      "Bash(dotnet build*)",
      "Bash(dotnet test*)",
      "Bash(dotnet format*)",
      "Bash(dotnet ef*)",
      "Bash(dotnet tool restore*)",
      "Bash(dotnet list*)",
      "Bash(dotnet new list*)",
      "Bash(dotnet sln*)",
      "Bash(npm run*)",
      "Bash(npx playwright*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(gitleaks*)",
      "Bash(python .claude/scripts/gates.py*)",
      "Bash(python .claude/scripts/prereqs.py*)",
      "Bash(python .claude/scripts/lint.py*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git diff*--ou*)",
      "Bash(git log*--ou*)",
      "Bash(git show*--ou*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Read(./.env*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets.json)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(~/.microsoft/usersecrets/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude_ai_Postman",
      "mcp__claude_ai_Microsoft_Learn"
    ],
    "ask": [
      "Write(/Directory.Packages.props)",
      "Edit(/Directory.Packages.props)",
      "Edit(**/Directory.Packages.props)",
      "Write(**/Directory.Packages.props)",
      "Edit(**/NuGet.config)",
      "Write(**/NuGet.config)",
      "Edit(**/nuget.config)",
      "Write(**/nuget.config)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Edit(**/.npmrc)",
      "Write(**/.npmrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_boundaries.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
