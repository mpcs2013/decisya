<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      CA1707 ("remove underscores from member names") is deliberately suppressed only
      here: xUnit test method names use underscore-separated, sentence-style names
      (e.g. Adding_Money_values_of_different_currencies_is_rejected) so each test's
      Gherkin scenario is readable from its name alone. This does not touch any other
      analyzer rule, and only applies to this test project.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="NodaTime.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.App flows in transitively from Decisya.ServiceDefaults; the
         loopback end-to-end test builds a real WebApplication on 127.0.0.1:0. -->
    <ProjectReference Include="..\..\src\Decisya.ServiceDefaults\Decisya.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\Decisya.SharedKernel\Decisya.SharedKernel.csproj" />
  </ItemGroup>

</Project>
