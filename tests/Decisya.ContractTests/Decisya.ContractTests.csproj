<Project Sdk="Microsoft.NET.Sdk">

  <!--
    #341 G2 (D9, rule R-L20): the OpenAPI contract tests. Builds the real Api host in-process
    (WebApplicationFactory, placeholder connection strings, no database), generates the ledger
    document and compares it with the committed openapi/ledger.json in Decisya.Modules.Ledger.Contracts.
    Category=Contract, so it runs in the fast lane. Same shape as tests/Decisya.Api.Tests.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- CA1707: sentence-style test names mirror the Gherkin scenarios. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <!-- WebApplicationFactory<Program>: the document is generated by the real host (already pinned). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Decisya.Api\Decisya.Api.csproj" />
    <ProjectReference Include="..\..\src\Modules\Ledger\Decisya.Modules.Ledger.Contracts\Decisya.Modules.Ledger.Contracts.csproj" />
  </ItemGroup>

</Project>
