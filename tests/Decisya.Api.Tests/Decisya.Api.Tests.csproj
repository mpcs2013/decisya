<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      CA1707 ("remove underscores from member names") is deliberately suppressed only
      here: xUnit test method names use underscore-separated, sentence-style names
      (e.g. Adding_Money_values_of_different_currencies_is_rejected) so each test's
      Gherkin scenario is readable from its name alone. This does not touch any other
      analyzer rule, and only applies to this test project.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
    <!-- WebApplicationFactory<Program>: the logging pipeline and the endpoint set are
         asserted on the real host #20 will extend, not on a stand-in. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Harness B (#20 G2): a real Keycloak container for the login-flow-adjacent negative
         cases (a genuine ID token, a refresh token, JWKS-keyed HS256). -->
    <PackageReference Include="Testcontainers.Keycloak" />
    <!-- BannedSymbols.txt bans DateTime(Offset).(Utc)Now repo-wide (CLAUDE.md platform
         invariant 4); TestTokenIssuer reads "now" through NodaTime's SystemClock instead. -->
    <PackageReference Include="NodaTime" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Decisya.Api\Decisya.Api.csproj" />
    <!-- #21, G2 "API tests": the throwaway Postgres fixture, to build the schema from an
         empty database. NOT Decisya.Infrastructure.Migrator directly: referencing it alongside
         Decisya.Api (both OutputType=Exe with an implicit top-level-statements "Program" type)
         gives CS0433 ("Program exists in both..."), and it also drags in
         Microsoft.EntityFrameworkCore.Design (pinned 10.0.12), which conflicts with the plain
         Microsoft.EntityFrameworkCore version Decisya.Api's own graph resolves via
         Npgsql.EntityFrameworkCore.PostgreSQL (MSB3277). Both are reported to Marco (G4
         evidence); until fixed centrally, TenancyDatabaseFixture runs TenancyDbContext's own
         compiled migrations directly against the fixture's owner connection, the same
         migrations MigrationRunner would run, without exercising the least-privilege
         decisya_tenancy role (that role's own isolation is G4-21-05, not this issue's G4-21-01/02).
    -->
    <ProjectReference Include="..\Decisya.TestInfrastructure\Decisya.TestInfrastructure.csproj" />
  </ItemGroup>

  <!--
    #20 G2: no project reference into src/Decisya.AppHost or tests/Decisya.Identity.Tests
    (mirrors Decisya.Bff.Tests/Decisya.Identity.Tests) — ContainerImages.cs is linked in as
    source so the AppHost's image reference and this project's Testcontainers fixture are
    literally the same compiled constants; OidcTestHelpers.cs, SecureCookieRelayHandler.cs and
    JwtHelper.cs are linked in as source (G2) rather than referenced, so this project cannot
    pull in Decisya.Identity.Tests' own Testcontainers/AppHost surface transitively.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Decisya.AppHost\ContainerImages.cs" Link="Linked\ContainerImages.cs" />
    <Compile Include="..\Decisya.Identity.Tests\OidcTestHelpers.cs" Link="Linked\OidcTestHelpers.cs" />
    <Compile Include="..\Decisya.Identity.Tests\SecureCookieRelayHandler.cs" Link="Linked\SecureCookieRelayHandler.cs" />
    <Compile Include="..\Decisya.Identity.Tests\JwtHelper.cs" Link="Linked\JwtHelper.cs" />
    <!-- #120 G4-120-05: the generated-certificate PKI and the in-process TLS stub, shared with
         Decisya.Bff.Tests so both prove the same trust behaviour. -->
    <Compile Include="..\Decisya.Bff.Tests\Trust\TlsTestPki.cs" Link="Linked\TlsTestPki.cs" />
  </ItemGroup>

</Project>
