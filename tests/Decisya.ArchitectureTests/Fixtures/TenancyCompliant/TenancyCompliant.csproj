<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Issue #22 green fixtures: the compliant counterpart to Fixtures/TenancyViolations, so
    TenancyRuleTests also proves each rule passes real, correct code, not only that it
    detects a violation.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- #231: the envelope-tenant setter and discovery rules (R6, R7) need real Wolverine types. -->
    <PackageReference Include="WolverineFx" />
  </ItemGroup>

  <ItemGroup>
    <!-- #231: an IDistributedCache sink for the key-builder rule (R10). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Decisya.SharedKernel\Decisya.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\..\src\Decisya.Infrastructure.Persistence\Decisya.Infrastructure.Persistence.csproj" />
    <!-- #24: the CrossTenantAuditRule fixtures call IAuditWriter.AppendAsync. -->
    <ProjectReference Include="..\..\..\..\src\Modules\Audit\Decisya.Modules.Audit.Contracts\Decisya.Modules.Audit.Contracts.csproj" />
  </ItemGroup>

</Project>
