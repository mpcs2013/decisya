<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Issue #22: the NetArchTest.Rules-based architecture rules that enforce CLAUDE.md
    invariant 1 (ITenantScoped) and ADR-0001 (the tenant query filter, its bypass list and
    the AllowCrossTenant escape hatch) across every module assembly (ArchitectureScope).
    Fixtures/TenancyViolations and Fixtures/TenancyCompliant are separate, real projects
    (referenced below), not compiled into this project, the same #32 NonCompliantClockUsage
    pattern.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      CA1707 ("remove underscores from member names"): xUnit test method names use
      underscore-separated, sentence-style names so each test's Gherkin scenario is
      readable from its name alone (same suppression as Decisya.SharedKernel.Tests).
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fixtures/* are separate projects, referenced via ProjectReference below; their
         source must not be double-compiled into this assembly. -->
    <Compile Remove="Fixtures/**/*.cs" />
    <None Include="Fixtures/**/*.cs" />
    <None Include="Fixtures/**/*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Issue #21: RepoPaths.cs needs the Decisya.RepoRoot AssemblyMetadata (ADR-0010, #36),
      which Directory.Build.props stamps only on a project whose name ends ".Tests" (the
      MSBuildProjectName.EndsWith('.Tests') condition). This project's name,
      Decisya.ArchitectureTests, has no dot before "Tests", so it is not matched there.
      Stamped directly here instead of touching Directory.Build.props (devops's file, not
      backend-dev's boundary).
    -->
    <AssemblyMetadata Include="Decisya.RepoRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Decisya.SharedKernel\Decisya.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Decisya.Infrastructure.Persistence\Decisya.Infrastructure.Persistence.csproj" />
    <!-- B-4 (#21): ArchitectureScope names every Decisya.Modules.*.csproj that is not a
         Contracts project. -->
    <ProjectReference Include="..\..\src\Modules\Tenancy\Decisya.Modules.Tenancy\Decisya.Modules.Tenancy.csproj" />
    <ProjectReference Include="..\..\src\Modules\Entitlements\Decisya.Modules.Entitlements\Decisya.Modules.Entitlements.csproj" />
    <!-- ContractsScope (#21, G2): every Decisya.Modules.*.Contracts assembly. -->
    <ProjectReference Include="..\..\src\Modules\Tenancy\Decisya.Modules.Tenancy.Contracts\Decisya.Modules.Tenancy.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Entitlements\Decisya.Modules.Entitlements.Contracts\Decisya.Modules.Entitlements.Contracts.csproj" />
    <ProjectReference Include="Fixtures\TenancyViolations\TenancyViolations.csproj" />
    <ProjectReference Include="Fixtures\TenancyCompliant\TenancyCompliant.csproj" />
  </ItemGroup>

</Project>
